<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>NexPane.App</RootNamespace>
    <AssemblyName>NexPane</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe icon resource (task P2.07); generated by tools/NexPane.AssetGen. -->
    <ApplicationIcon>..\..\assets\icons\NexPane.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Title-bar / taskbar icon of the WPF windows (MainWindow Icon="/Assets/NexPane.ico"). -->
    <Resource Include="..\..\assets\icons\NexPane.ico" Link="Assets\NexPane.ico" />
    <!-- Notification-area icons for NexPane.Shell.Tray.TrayIcon, copied next to NexPane.exe under Assets\. -->
    <Content Include="..\..\assets\icons\tray.ico;..\..\assets\icons\tray-light.ico;..\..\assets\icons\tray-dark.ico">
      <Link>Assets\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexPane.Core\NexPane.Core.csproj" />
    <ProjectReference Include="..\NexPane.Shell\NexPane.Shell.csproj" />
    <ProjectReference Include="..\NexPane.Storage\NexPane.Storage.csproj" />
    <ProjectReference Include="..\NexPane.Security\NexPane.Security.csproj" />
    <ProjectReference Include="..\NexPane.Indexing\NexPane.Indexing.csproj" />
    <ProjectReference Include="..\NexPane.Search\NexPane.Search.csproj" />
    <ProjectReference Include="..\NexPane.Archives\NexPane.Archives.csproj" />
    <ProjectReference Include="..\NexPane.Network\NexPane.Network.csproj" />
    <ProjectReference Include="..\NexPane.Sync\NexPane.Sync.csproj" />
    <ProjectReference Include="..\NexPane.Metadata\NexPane.Metadata.csproj" />
    <ProjectReference Include="..\NexPane.Scripting\NexPane.Scripting.csproj" />
    <ProjectReference Include="..\NexPane.AI\NexPane.AI.csproj" />
    <ProjectReference Include="..\NexPane.Preview\NexPane.Preview.csproj" />
  </ItemGroup>

</Project>
