# ---------------------------------------------------------------
# NexPane .gitignore — .NET / Visual Studio / Rider / VS Code
# NOTE: Branding assets (assets/**/*.ico, *.png, *.bmp, *.svg) are
# COMMITTED on purpose. Do not add image or icon patterns here.
# ---------------------------------------------------------------

# Project output folders
/build/
/dist/

# .NET build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json

# Test / coverage / benchmark results
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
BenchmarkDotNet.Artifacts/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.rsuser
*.ncb
*.aps
*.VC.db
*.VC.VC.opendb
ipch/
*.pdb.tmp

# Rider / ReSharper
.idea/
*.sln.iml
_ReSharper*/
*.DotSettings.user

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NuGet
packages/
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Publish profiles output
PublishScripts/
*.pubxml.user

# Inno Setup compiler output (installer lands in /dist/)
installer/Output/

# Local secrets / environment (never commit)
*.env
.env.*
secrets/
*.pfx
*.p12
*.snk.private

# Local test data generated at runtime
tests/**/TestOutput/
*.vhdx

# Whisper / AI models downloaded locally
models/
*.ggml
*.gguf

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor temp
*~
*.swp
*.tmp
*.bak
